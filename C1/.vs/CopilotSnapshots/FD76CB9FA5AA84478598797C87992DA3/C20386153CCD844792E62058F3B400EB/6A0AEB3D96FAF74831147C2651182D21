        private void GoToBtn_Click(object sender, EventArgs e)
            {
                // Feedback visual immediat
                GoToBtn.BackColor = Color.Yellow;
                GoToBtn.ForeColor = Color.Black;
                GoToBtn.Text = "Yendo...";

                // Funció per acceptar tant "41.2755" com "41,2755"
                float ParseFloatFlexible(string s)
                {
                    s = s.Trim();

                    // 1) Intenta amb cultura actual
                    if (float.TryParse(s, NumberStyles.Float, CultureInfo.CurrentCulture, out float v1))
                        return v1;

                    // 2) Intenta amb Invariant (punt)
                    if (float.TryParse(s, NumberStyles.Float, CultureInfo.InvariantCulture, out float v2))
                        return v2;

                    // 3) Últim intent: canviar coma/punt
                    s = s.Replace(',', '.');
                    if (float.TryParse(s, NumberStyles.Float, CultureInfo.InvariantCulture, out float v3))
                        return v3;

                    throw new FormatException();
                }

                try
                {
                    float lat = ParseFloatFlexible(LatTxBox.Text);
                    float lon = ParseFloatFlexible(LonTxBox.Text);
                    float alt = ParseFloatFlexible(AltTxBox.Text);

                    MessageBox.Show($"Enviando lat={lat} lon={lon} alt={alt}");
                    // Enviem comanda
                    dron.IrAlPunto(lat, lon, alt, bloquear: false);

                    // Si arriba fins aquí, com a mínim la comanda s'ha enviat
                    GoToBtn.BackColor = Color.Green;
                    GoToBtn.ForeColor = Color.White;
                    GoToBtn.Text = "Enviado";
                }
                catch (FormatException)
                {
                    GoToBtn.BackColor = Color.Red;
                    GoToBtn.ForeColor = Color.White;
                    GoToBtn.Text = "Error";
                }
                catch (Exception ex)
                {
                    GoToBtn.BackColor = Color.Red;
                    GoToBtn.ForeColor = Color.White;
                    GoToBtn.Text = "Fallo";
                    MessageBox.Show(ex.Message);
                }
